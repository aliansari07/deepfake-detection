# Environment variables read by the Python code and the website backend.
# The code reads them from the process environment; it does not load this file.
# Set them in your shell before running, for example:
#   PowerShell:  $env:DD_ALLOWED_ORIGINS = "http://localhost:3000"
#   bash:        export DD_ALLOWED_ORIGINS="http://localhost:3000"
# The front end's own settings live in website/.env.local.example.

# ── Data ────────────────────────────────────────────────────
# Split file used by training and evaluation (default: splits/legacy_t4-20.json).
# New runs should use the identity-disjoint split:
DD_SPLIT_FILE=splits/ffpp_official_v1.json

# ── Website backend (website/backend/main.py) ───────────────
# Checkpoint to serve: a bare name under checkpoints/, a repo-relative path, or an absolute path.
DD_CHECKPOINT=models/demo.pt
# Upload size cap in MB.
DD_MAX_UPLOAD_MB=200
# Comma-separated browser origins allowed to call the API.
DD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Plain-language explanations (src/explain.py) ────────────
# "local" (default, offline template) or "claude" (Anthropic API; falls back to local on failure).
DD_EXPLAIN_PROVIDER=local
# Only needed when DD_EXPLAIN_PROVIDER=claude. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional model override for the "claude" provider.
# DD_EXPLAIN_MODEL=
